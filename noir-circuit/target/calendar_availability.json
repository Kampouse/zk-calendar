{"noir_version":"1.0.0-beta.21+89a0f0faf3a5f1273c8ac4843b7877882437e277","hash":"8222586818529171370","abi":{"parameters":[{"name":"claim_start","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"public"},{"name":"claim_duration","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"public"},{"name":"busy_starts","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":64}},"visibility":"private"},{"name":"busy_durations","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":64}},"visibility":"private"},{"name":"num_busy","type":{"kind":"integer","sign":"unsigned","width":32},"visibility":"private"}],"return_type":null,"error_types":{"361444214588792908":{"error_kind":"string","string":"attempt to multiply with overflow"},"14990209321349310352":{"error_kind":"string","string":"attempt to add with overflow"}}},"bytecode":"","debug_symbols":"","file_map":{"49":{"source":"// ZK Calendar Availability Proof\n//\n// Proves that a given time slot is free WITHOUT revealing:\n// - What other events exist\n// - Where you are\n// - What you're doing\n\nglobal MAX_BUSY_SLOTS: u32 = 32;\n\n// Returns the claimed free slot (public output) after proving no overlap\nfn main(\n    // PUBLIC outputs (return values)\n    claim_start: pub u64,\n    claim_duration: pub u64,\n\n    // PRIVATE inputs: your busy slots - never revealed\n    busy_starts: [u64; MAX_BUSY_SLOTS],\n    busy_durations: [u64; MAX_BUSY_SLOTS],\n\n    // PRIVATE: number of actual busy slots (rest are padding)\n    num_busy: u32,\n) {\n    // For each busy slot, prove it does not overlap with the claimed free slot\n    for i in 0..MAX_BUSY_SLOTS {\n        let is_real = i < num_busy;\n\n        if is_real {\n            let busy_start = busy_starts[i];\n            let busy_duration = busy_durations[i];\n\n            let claim_end = claim_start + claim_duration * 60;\n            let busy_end = busy_start + busy_duration * 60;\n\n            let no_overlap_left = claim_end <= busy_start;\n            let no_overlap_right = busy_end <= claim_start;\n            let no_overlap = no_overlap_left | no_overlap_right;\n\n            assert(no_overlap);\n        }\n    }\n}\n","path":"/Users/asil/.openclaw/workspace/zk-calendar/noir-circuit/src/main.nr","function_locations":[{"start":604,"name":"main"}]}}}